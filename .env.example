# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key - server-only, never expose to the client. Used solely by
# the Stripe webhook to write subscription state without a user session.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude) - powers weekly plan + video detail generation
ANTHROPIC_API_KEY=
# Set to "true" to skip real Claude calls and return templated sample content
# instead - lets you test the full app for free, but isn't representative of
# real generation quality. Never set this in a deploy meant for real customers.
MOCK_AI=

# Creatomate - powers the real auto-editing pipeline (multi-clip cuts +
# burned-in captions). Optional: leave unset to keep using the free
# MockRenderProvider (see src/lib/video/). New Creatomate accounts get 50
# free render credits (no card required, ~3.5 min of 720p video) - enough to
# test this in-app before deciding on a paid tier (~$54/mo+, Essential).
CREATOMATE_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for the two subscription tiers (Stripe Dashboard -> Product
# catalog) - Base is $15/mo for 5 videos/week, Pro is $20/mo for 10/week.
# See src/lib/plans.ts for the tier -> videos-per-week mapping.
STRIPE_PRICE_ID_BASE=
STRIPE_PRICE_ID_PRO=
# Set to "true" to unlock a free tier switcher on the billing page that sets
# your own subscription tier directly (bypassing Stripe entirely) so you can
# test Base vs. Pro enforcement without paying. Never set this in a deploy
# with real paying customers - it lets any signed-in user grant themselves a
# paid tier for free.
MOCK_BILLING=
