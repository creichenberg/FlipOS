# Postgres connection string (Supabase, Neon, Railway, or local Postgres all work)
DATABASE_URL="postgresql://user:password@localhost:5432/flipos"

# Anthropic API key - used for listing analysis (get one at console.anthropic.com)
ANTHROPIC_API_KEY="sk-ant-..."

# eBay Developer Program (Browse API, client-credentials grant) - powers the /search page.
# Leave blank and /search will show a "not connected" message; everything else still works.
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
# Optional, defaults to EBAY_US. See eBay's marketplace id docs for other storefronts.
EBAY_MARKETPLACE_ID=""

# Phase 3 - deal alerts. Resend (resend.com) sends the alert emails; leave blank and
# saved searches still track/dedup matches, they just won't email anyone.
RESEND_API_KEY=""
# Must be a verified sender/domain in your Resend account.
ALERT_FROM_EMAIL="FlipOS Alerts <alerts@yourdomain.com>"

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when it calls
# /api/cron/deal-alerts. Leave blank in local dev; set it in Vercel for production
# so the endpoint can't be triggered by anyone who finds the URL.
CRON_SECRET=""
