generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Users ----------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  preferences UserPreference?
  listings    Listing[]
  savedFlips  SavedFlip[]
}

model UserPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories       String[] @default([])
  maxPurchasePrice Float?
  minProfit        Float?
  minROI           Float?
  updatedAt        DateTime @updatedAt
}

// ---------- Listings & Analysis ----------

model Listing {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  askingPrice Float
  marketplace String? // eBay, Facebook Marketplace, Craigslist, OfferUp, etc.
  sourceUrl   String?
  imageUrls   String[] @default([])
  createdAt   DateTime @default(now())

  analysis FlipAnalysis?
}

model FlipAnalysis {
  id        String  @id @default(cuid())
  listingId String  @unique
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Product identification (as the AI understood it)
  identifiedProduct String
  brand             String?
  category          String?
  conditionAssessed String?

  // Market estimate
  estimatedResaleValueLow  Float
  estimatedResaleValueHigh Float
  demand                   Demand
  competition              Competition
  confidence               Confidence

  // Financials
  estimatedProfit Float
  roi             Float

  // Flip Score
  flipScore     Int
  flipCategory  FlipCategory
  flipReasoning String

  // Risk
  riskFactors    String[] @default([])
  thingsToCheck  String[] @default([])
  whyUnderpriced String?

  // Buying strategy
  buyDecision           BuyDecision
  recommendedOfferPrice Float?
  negotiationMessage    String?

  // Selling strategy
  bestPlatform         String?
  recommendedSellPrice Float?
  listingTitle         String?
  listingDescription   String?
  keywords             String[] @default([])
  photosNeeded         String[] @default([])

  rawModelOutput Json // full structured JSON from the AI, for audit/debugging
  createdAt      DateTime @default(now())

  savedFlip SavedFlip?
}

// ---------- Saved Flips / Completed Sales ----------

model SavedFlip {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId String  @unique
  analysis   FlipAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  status FlipStatus @default(SAVED)

  purchasedAt     DateTime?
  purchasePrice   Float?
  listedAt        DateTime?
  soldAt          DateTime?

  actualSalePrice Float?
  actualProfit    Float?
  actualROI       Float?

  createdAt DateTime @default(now())
}

enum FlipStatus {
  SAVED
  PURCHASED
  LISTED
  SOLD
}

enum Demand {
  HIGH
  MEDIUM
  LOW
}

enum Competition {
  HIGH
  MEDIUM
  LOW
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}

enum BuyDecision {
  BUY
  NEGOTIATE
  PASS
}

enum FlipCategory {
  EXCEPTIONAL
  STRONG
  AVERAGE
  WEAK
  AVOID
}
